{
  "__comment": "go-signalium outbox dashboard. Assumes a Prometheus datasource fed from the signalium.outbox.* metrics (dots -> underscores, tags -> labels; timer quantiles exposed as the `quantile` label). See docs/observability.md 'Visualizing the metrics'. The datasource is a template variable, so the dashboard imports cleanly into any Grafana.",
  "title": "go-signalium — Outbox",
  "description": "Delivery health, backlog, and worker health for the go-signalium outbox. Datasource is templated; see docs/observability.md for the metric-name mapping.",
  "tags": ["go-signalium", "outbox", "signal"],
  "editable": true,
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {}
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Delivery",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Terminal outcomes (rate)",
      "description": "Rate of rows reaching a terminal status, by reason. A rising permanent_failed or timed_out line is the first sign of trouble.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (status) (rate(signalium_outbox_terminal[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Send latency",
      "description": "signal-cli send round-trip. Witchcraft blocklists p50/mean for timers, so p99 and p999 are the available quantiles.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "signalium_outbox_send{quantile=\"0.99\"}",
          "legendFormat": "p99 {{outcome}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "signalium_outbox_send{quantile=\"0.999\"}",
          "legendFormat": "p999 {{outcome}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Backlog",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Backlog depth",
      "description": "Rows still awaiting delivery (PENDING + FAILED). Sampled by the timeout reaper on its tick, so it updates at the reaper cadence.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "signalium_outbox_backlog_depth",
          "legendFormat": "depth"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Oldest undelivered age",
      "description": "Age of the oldest row still awaiting delivery — the head-of-line latency. Alert if it crosses your freshness budget.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "signalium_outbox_backlog_oldest_age_seconds",
          "legendFormat": "oldest age"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Worker health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Claim latency (p99)",
      "description": "Time to claim one row. With the poll cadence, a rising p99 means DB pressure or worker saturation.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "signalium_outbox_claim{quantile=\"0.99\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retry rate",
      "description": "Transient failures rescheduled for a later attempt. Pairs with send{outcome=error}.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(signalium_outbox_retry[5m])",
          "legendFormat": "retries/s"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Inbound events dropped",
      "description": "Inbound signal-cli events dropped on a full buffer. Any sustained value means the inbound consumer is too slow or the buffer is undersized.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (method) (rate(signalium_outbox_inbound_dropped[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    }
  ]
}
